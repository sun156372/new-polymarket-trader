# Copy to .env and fill locally. NEVER commit .env.
# Live trading private key (Polygon wallet). Leave blank for paper mode.
POLYMARKET_PRIVATE_KEY=

# Optional Polymarket funder/proxy address (if using a Polymarket proxy wallet).
POLYMARKET_FUNDER=

# Polygon RPC for on-chain redeem.
POLYGON_RPC_URL=https://polygon-rpc.com

# --- PolyBolt / Chainlink TWAP (reference-price WebSocket) ---
# PolyBolt reference-price channels require the same L2 CLOB credentials used
# by the Polymarket REST API.  Create them with the CLOB /auth/api-key endpoint
# and paste them here; never commit the real .env.
POLYMARKET_CLOB_API_KEY=
POLYMARKET_CLOB_API_SECRET=
POLYMARKET_CLOB_API_PASSPHRASE=

# Optional one-shot HTTP fallback. Polymarket does not publish an
# unauthenticated REST TWAP endpoint; set this to a provider you trust that
# returns JSON with symbol/value/timestamp (and optional window_seconds).
# The URL may contain {symbol} and {window_seconds} placeholders.
POLYMARKET_TWAP_REST_URL=
POLYMARKET_TWAP_REST_KEY=

